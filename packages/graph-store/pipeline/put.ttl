PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
@base <https://barnard59.zazuko.com/pipeline/graph-store/> .
@prefix b59: <https://barnard59.zazuko.com/vocab#> .
@prefix code: <https://code.described.at/> .
@prefix p: <https://pipeline.described.at/> .
@prefix op: <https://barnard59.zazuko.com/operations/> .

<put> a p:Pipeline ;
  p:variables
    [
      p:variable
        [
          a p:Variable ;
          p:name "source" ;
          rdfs:label "Glob of RDF documents to upload" ;
        ],
        [
          a p:Variable ;
          p:name "graph" ;
          rdfs:label "Target graph IRI or DEFAULT for the default graph" ;
        ],
        [
          a p:Variable ;
          p:name "endpoint" ;
        ],
        [
          a p:Variable ;
          p:name "allow-empty" ;
          p:required false ;
          p:value false ;
          b59:flag true ;
          rdfs:label "Succeed without uploading if the source contains no RDF quads" ;
        ],
        [
          a p:Variable ;
          p:name "allow-clear" ;
          p:required false ;
          p:value false ;
          b59:flag true ;
          rdfs:label "Clear the target graph if the source contains no RDF quads" ;
        ],
        [
          a p:Variable ;
          p:name "user" ;
          p:required false ;
        ],
        [
          a p:Variable ;
          p:name "password" ;
          p:required false ;
          p:sensitive true ;
        ] ;
    ] ;
  p:steps
    [
      p:stepList
        (
          [
            op:base\/glob
              [
                code:name "pattern" ;
                code:value "source"^^p:VariableName
              ],
              [
                code:name "nodir" ;
                code:value true
              ]
          ]
          [ op:rdf\/fs.js\#parse () ]
          [
            op:graph-store\/put
              [
                code:name "graph" ;
                code:value "graph"^^p:VariableName ;
              ],
              [
                code:name "endpoint" ;
                code:value "endpoint"^^p:VariableName ;
              ],
              [
                code:name "allowEmpty" ;
                code:value "allow-empty"^^p:VariableName ;
              ],
              [
                code:name "allowClear" ;
                code:value "allow-clear"^^p:VariableName ;
              ],
              [
                code:name "user" ;
                code:value "user"^^p:VariableName ;
              ],
              [
                code:name "password" ;
                code:value "password"^^p:VariableName ;
              ]
          ]
        )
    ] ;
.
