@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix p: <https://pipeline.described.at/> .
@prefix code: <https://code.described.at/> .
@base <https://barnard59.zazuko.com/operations/> .

<https://barnard59.zazuko.com/pipeline/n3/apply> a p:Pipeline, p:Readable ;
  p:variables [
    p:variable [ 
      a p:Variable ;
      p:name "rules" ; 
      rdfs:label "Path of the N3 rules file, relative to the working directory or absolute" ;
      p:required true ;
    ] , [
      a p:Variable ;
      p:name "include" ; 
      rdfs:label "Set to 'all' to include the input dataset" ;
      p:required false ;
    ] ;
  ] ;
  p:steps
    [
      p:stepList
        (
          [ <base/stdin> () ]
          <https://barnard59.zazuko.com/pipeline/n3/_apply>
        )
    ] ;
.

<https://barnard59.zazuko.com/pipeline/n3/_apply> a p:Pipeline , p:Writable, p:Readable;
  p:steps
    [
      p:stepList
      (
        [ <formats/n3/parse> () ]
        [ <rdf/getDataset> () ]
        _:applyRules
        [ <base/flatten> () ]
        [ <formats/ntriples/serialize> () ]
      )
    ]
.


_:applyRules a p:Step ;
  code:implementedBy [ a code:EcmaScriptModule ;
    code:link <file:../applyRulesFromFile.js#default>
  ] ;
  code:arguments 
    [ code:name "rulesPath" ; code:value "rules"^^p:VariableName ] ,
    [ code:name "includeInput" ; code:value "this.variables.get('include') === 'all'"^^code:EcmaScript ]
.
