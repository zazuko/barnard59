{
    "@context": {
        "@base": "http://example.org/pipeline/",
        "@vocab": "https://pipeline.described.at/",
        "code": "https://code.described.at/",
        "code:arguments": {
            "@container": "@list"
        },
        "code:link": {
            "@type": "@id"
        },
        "operation": {
            "@type": "@id"
        },
        "steps": {
            "@type": "@id"
        },
        "stepList": {
            "@container": "@list"
        }
    },
    "@graph": [
        {
            "@id": "utc",
            "@type": [
                "Pipeline",
                "Readable"
            ],
            "variables": {
                "variable": [
                    {
                        "@type": "Variable",
                        "name": "url",
                        "value": "https://worldtime.timezone.io/api/timezone/Etc/UTC"
                    },
                    {
                        "@id": "dateContext"
                    }
                ]
            },
            "steps": "steps"
        },
        {
            "@id": "cet",
            "@type": [
                "Pipeline",
                "Readable"
            ],
            "variables": {
                "variable": [
                    {
                        "@type": "Variable",
                        "name": "url",
                        "value": "https://worldtime.timezone.io/api/timezone/Europe/Amsterdam"
                    },
                    {
                        "@id": "dateContext"
                    }
                ]
            },
            "steps": "steps"
        },
        {
            "@id": "dateContext",
            "@type": "Variable",
            "name": "context",
            "value": "{\"date\":\"http://purl.org/dc/elements/1.1/date\"}"
        },
        {
            "@id": "steps",
            "stepList": [
                {
                    "@id": "fetch",
                    "code:implementedBy": {
                        "code:link": "node:barnard59-http#get",
                        "@type": "code:EcmaScript"
                    },
                    "code:arguments": [
                        {
                            "@value": "${url}",
                            "@type": "code:EcmaScriptTemplateLiteral"
                        }
                    ]
                },
                {
                    "@id": "parseJson",
                    "code:implementedBy": {
                        "code:link": "node:barnard59-base/json.js#parseDocument",
                        "@type": "code:EcmaScriptModule"
                    }
                },
                {
                    "@id": "jsonldStructure",
                    "code:implementedBy": {
                        "code:link": "node:barnard59-base/map.js#default",
                        "@type": "code:EcmaScript"
                    },
                    "code:arguments": [
                        {
                            "@value": "json => { return { '@context': JSON.parse(this.variables.get('context')), '@id': this.variables.get('url'), date: json.datetime } }",
                            "@type": "code:EcmaScript"
                        }
                    ]
                },
                {
                    "@id": "parse",
                    "code:implementedBy": {
                        "code:link": "node:barnard59-formats/jsonld.js#parseObject",
                        "@type": "code:EcmaScript"
                    }
                },
                {
                    "@id": "serialize",
                    "code:implementedBy": {
                        "code:link": "node:barnard59-formats/ntriples.js#serialize",
                        "@type": "code:EcmaScript"
                    }
                }
            ]
        }
    ]
}
