@base <http://ld.admin.ch/pipeline/metadata/> .
@prefix code: <https://code.described.at/> .
@prefix p: <https://pipeline.described.at/> .

_:vars p:variable
  [ a p:Variable; p:name "organizations" ] ,
  [ a p:Variable; p:name "namespaces" ] .

_:uploadVars p:variable
  [ a p:Variable; p:name "graph" ] ,
  [ a p:Variable; p:name "endpoint" ] ,
  [ a p:Variable; p:name "user"; p:required false ] ,
  [ a p:Variable; p:name "password"; p:required false; p:sensitive true ] .


<mainCreateFile> a p:Pipeline, p:Readable;
  p:variables _:vars ;
  p:steps [
    p:stepList (<concatFiles> <serialize>)
  ].

<mainUpload> a p:Pipeline;
  p:variables _:vars, _:uploadVars ;
  p:steps [
    p:stepList (<concatFiles> <upload>)
  ].


<concatFiles> a p:Step;
  code:implementedBy [ a code:EcmaScript;
    code:link <node:barnard59-base/concat.js#object>
  ];
  code:arguments (<parseNames> <parseOrgs>).


<parseNames> a p:Pipeline, p:ReadableObjectMode;
  p:variables _:vars ;
  p:steps [
    p:stepList ( <readFileNames> <parseTurtle> )
  ].

<parseOrgs> a p:Pipeline, p:ReadableObjectMode;
  p:variables _:vars;
  p:steps [
    p:stepList ( <readFileOrgs> <parseTurtle> )
  ].

<readFileNames> a p:Step;
  code:implementedBy [
    code:link <node:fs#createReadStream>;
    a code:EcmaScript
  ];
  code:arguments ("namespaces"^^p:VariableName).

<readFileOrgs> a p:Step;
  code:implementedBy [
    code:link <node:fs#createReadStream>;
    a code:EcmaScript
  ];
  code:arguments ("organizations"^^p:VariableName).


<parseTurtle> a p:Step;
  code:implementedBy [
    code:link <node:barnard59-formats/n3.js#parse>;
    a code:EcmaScript
  ].

<serialize> a p:Step;
  code:implementedBy [
    code:link <node:barnard59-formats/ntriples.js#serialize> ;
    a code:EcmaScript
  ].

<upload> a p:Step;
  code:implementedBy [ a code:EcmaScript;
    code:link <node:barnard59-graph-store/put.js#default>
  ];
  code:arguments [
    code:name "graph";
    code:value "graph"^^p:VariableName
  ], [
    code:name "endpoint";
    code:value "endpoint"^^p:VariableName
  ], [
    code:name "user";
    code:value "user"^^p:VariableName
  ], [
    code:name "password";
    code:value "password"^^p:VariableName
  ].
