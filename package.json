{
  "name": "barnard59-root",
  "private": true,
  "version": "1.1.4",
  "description": "Barnard59 Linked Data pipelines",
  "type": "module",
  "scripts": {
    "lint": "eslint . --quiet",
    "test": "npm run -ws --if-present test",
    "release": "changeset publish",
    "postinstall": "skills experimental_sync -y",
    "prepare": "husky",
    "skills:check": "skill-check check packages --no-security-scan --fail-on-warning"
  },
  "workspaces": [
    "packages/*",
    "test/*"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "^3",
    "@tpluscode/eslint-config": "^4.0.4",
    "@types/chai": "^5.2.3",
    "@types/sinon-chai": "^4.0.1",
    "@types/node": "^18",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "find-workspaces": "^0.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "mocha": "^12",
    "sinon-chai": "^4.0.1",
    "skill-check": "^1.2.0",
    "skills": "^1.9.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix --quiet"
    ]
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "skills": [
    "npm:@zazuko/env",
    "npm:barnard59",
    "npm:barnard59-base",
    "npm:barnard59-csvw",
    "npm:barnard59-cube",
    "npm:barnard59-formats",
    "npm:barnard59-ftp",
    "npm:barnard59-graph-store",
    "npm:barnard59-http",
    "npm:barnard59-n3",
    "npm:barnard59-rdf",
    "npm:barnard59-s3",
    "npm:barnard59-shacl",
    "npm:barnard59-sparql"
  ]
}
